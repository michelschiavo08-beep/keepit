# .env.example - Configurações de Ambiente para o KeepIT
# Copie este arquivo para .env caso deseje configurar um banco externo (ex.: MySQL ou PostgreSQL).
# Se o arquivo .env não for criado, o sistema roda automaticamente com o banco H2 em memória.

# Porta em que a aplicação Spring Boot será executada
PORT=8080

# Configurações do Banco de Dados Relacional
DB_HOST=localhost
DB_PORT=3306
DB_NAME=keepit_db
DB_USER=root
DB_PASS=sua_senha_aqui

# URL JDBC e Driver da Conexão
# Para MySQL 8+:
DB_URL=jdbc:mysql://localhost:3306/keepit_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Para PostgreSQL (descomente se for utilizar PostgreSQL):
# DB_URL=jdbc:postgresql://localhost:5432/keepit_db
# DB_DRIVER=org.postgresql.Driver
